{
  "id": "code-analysis",
  "name": "Code Analysis Skill",
  "version": "1.0.0",
  "description": "Searches the workspace for code references without modifying files.",
  "author": "QUACK",
  "trustLevel": "builtin",
  "requiredCapabilities": ["permission.workspace.read"],
  "allowedTools": ["core.workspace.code-search"],
  "inputSchema": {
    "type": "object",
    "properties": {
      "pattern": { "type": "string" }
    },
    "required": ["pattern"]
  },
  "outputSchema": { "type": "object" },
  "executionLimits": {
    "timeoutMs": 8000,
    "maxIterations": 1,
    "maxToolCalls": 1,
    "maxRetriesPerStep": 0
  },
  "category": "analysis",
  "tags": ["code", "analysis", "search"],
  "workflow": {
    "steps": [
      {
        "id": "search",
        "description": "Search source code for the requested query.",
        "requiredTools": ["core.workspace.code-search"],
        "toolInvocations": [
          {
            "toolId": "core.workspace.code-search",
            "input": { "pattern": { "$fromParameter": "pattern" } },
            "reason": "Find code references for analysis."
          }
        ]
      }
    ]
  }
}
