{
  "name": "@quack/sdk",
  "version": "1.0.0",
  "private": true,
  "description": "QUACK SDK - TypeScript client library for building on QUACK AI Operating System",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./swe": {
      "types": "./dist/swe.d.ts",
      "import": "./dist/swe.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm --prefix .. run build && tsc",
    "typecheck": "npm --prefix .. run build && tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@quack/os": "^1.0.0"
  },
  "devDependencies": {
    "@quack/os": "file:.."
  },
  "engines": {
    "node": ">=20"
  }
}
